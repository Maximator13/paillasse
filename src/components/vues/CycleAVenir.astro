---
// Page d'attente d'un cycle non encore publié (collège, prépa) : programme prévu, classe par classe.
import Base from '../../layouts/Base.astro';
import { UI, lien, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  cycle: 'college' | 'prepa';
}
const { lang, cycle } = Astro.props;
const u = UI[lang];

const T = {
  college: {
    fr: {
      titre: 'Physique-chimie au collège',
      description: "Programme prévu pour le collège (5e, 4e, 3e) : chapitres et TP animés en préparation, de l'eau qui gèle aux circuits électriques.",
      fil: 'Collège',
      surtitre: 'Cycle 4',
      h1: 'Le collège arrive bientôt.',
      chapo: 'Les cours et TP animés du collège sont en préparation. Voici le programme prévu, classe par classe. En attendant, tout le programme de Terminale est déjà disponible.',
      cta: 'Découvrir la Terminale',
      classes: [
        {
          nom: '5e',
          chapitres: ["États et changements d'état de l'eau", 'Mélanges et corps purs', 'Circuits électriques simples', 'Lumière et propagation rectiligne'],
          tp: ["Courbe de solidification de l'eau", 'Décantation, filtration, distillation', 'Montage série et dérivation'],
        },
        {
          nom: '4e',
          chapitres: ['Atomes, molécules et transformations chimiques', 'Masse volumique', 'Vitesse et mouvements', "Loi d'Ohm, tension et intensité", 'Son : propagation et vitesse'],
          tp: ['Combustion du carbone', "Mesure d'une masse volumique", 'Tracer U = f(I) pour une résistance'],
        },
        {
          nom: '3e',
          chapitres: ['Ions, pH et réactions acide-métal', 'Gravitation et poids', 'Énergie cinétique et sécurité routière', 'Puissance et énergie électriques', 'Signaux lumineux et sonores'],
          tp: ["Action de l'acide chlorhydrique sur le fer", 'Distance de freinage', "Chute d'un objet et énergie"],
        },
      ],
    },
    en: {
      titre: 'Physics and chemistry at collège',
      description: 'Planned syllabus for collège (5e, 4e, 3e, ages 12 to 15): chapters and animated practicals in preparation, from freezing water to electric circuits.',
      fil: 'Collège',
      surtitre: 'Cycle 4 (lower secondary, ages 12 to 15)',
      h1: 'Collège is coming soon.',
      chapo: 'The collège lessons and animated practicals are in preparation. Here is the planned syllabus, year by year. In the meantime, the whole Terminale syllabus is already available.',
      cta: 'Discover Terminale',
      classes: [
        {
          nom: '5e (ages 12 to 13)',
          chapitres: ['States and changes of state of water', 'Mixtures and pure substances', 'Simple electric circuits', 'Light and rectilinear propagation'],
          tp: ['Freezing curve of water', 'Decantation, filtration, distillation', 'Series and parallel circuits'],
        },
        {
          nom: '4e (ages 13 to 14)',
          chapitres: ['Atoms, molecules and chemical changes', 'Density', 'Speed and motion', "Ohm's law, voltage and current", 'Sound: propagation and speed'],
          tp: ['Combustion of carbon', 'Measuring a density', 'Plotting U = f(I) for a resistor'],
        },
        {
          nom: '3e (ages 14 to 15)',
          chapitres: ['Ions, pH and acid-metal reactions', 'Gravitation and weight', 'Kinetic energy and road safety', 'Electrical power and energy', 'Light and sound signals'],
          tp: ['Action of hydrochloric acid on iron', 'Braking distance', 'A falling object and energy'],
        },
      ],
    },
  },
  prepa: {
    // Plus servie : /prepa/ est désormais l'accueil des filières (src/pages/prepa/index.astro).
    fr: {
      titre: 'Physique-chimie en prépa',
      description: 'Programme prévu pour les classes préparatoires MPSI et PCSI : chapitres et TP animés en préparation, de la mécanique aux équilibres chimiques.',
      fil: 'Prépa',
      surtitre: 'Classes préparatoires',
      h1: 'La prépa est en préparation.',
      chapo: "Les cours et TP animés de première année de prépa scientifique sont en cours d'écriture. Voici le programme prévu. Pour réviser les bases indispensables, commencez par la Terminale.",
      cta: 'Réviser la Terminale',
      classes: [
        {
          nom: 'MPSI',
          chapitres: ['Mécanique du point et oscillateurs', 'Circuits électriques en régime transitoire', 'Optique géométrique', 'Premier et second principes de la thermodynamique', 'Architecture de la matière et cristallographie'],
          tp: ['Pendule simple et non-linéarité', 'Circuit RLC série : régimes libres', 'Focométrie de lentilles minces'],
        },
        {
          nom: 'PCSI',
          chapitres: ['Cinétique chimique et mécanismes', 'Équilibres acido-basiques et de précipitation', 'Oxydoréduction et diagrammes E-pH', 'Mécanique du point et du solide', 'Thermodynamique des machines'],
          tp: ['Méthode des vitesses initiales', 'Titrage par précipitation', "Cycle d'un moteur ditherme"],
        },
      ],
    },
    // Page d'attente anglaise : la prépa (concours français) n'existe qu'en français.
    en: {
      titre: 'Prépa revision, in French',
      description: 'Revision sheets, quizzes and exam-style exercises for the French TSI preparatory class, written in French only. MPSI, PCSI and PTSI will follow.',
      fil: 'Prépa',
      surtitre: 'Preparatory classes',
      h1: 'Prépa revision is in French.',
      chapo: 'The revision material for the science preparatory classes (prépa) prepares students for the French competitive entrance exams, so it is written in French only. The TSI track comes first: condensed lesson sheets, formulas to learn, quizzes and exam-style exercises with full solutions.',
      cta: 'Open the French version',
      classes: [],
    },
  },
}[cycle][lang];
// La prépa n'a pas de version anglaise : le bouton mène à la page française et aucune balise hreflang n'est émise.
const francais = cycle === 'prepa';
---

<Base lang={lang} titre={T.titre} description={T.description} sansTraduction={francais ? '/prepa/' : undefined}>
  <section class="section conteneur">
    <ol class="fil"><li><a href={lien(lang, '/')}>{u.accueil}</a></li><li aria-current="page">{T.fil}</li></ol>
    <p class="surtitre">{T.surtitre}{!francais && ` · ${u.aVenir}`}</p>
    <h1>{T.h1}</h1>
    <p class="chapo">{T.chapo}</p>
    <p class="actions">
      {francais
        ? <a class="btn principal" href={lien('fr', '/prepa/')} hreflang="fr">{T.cta}</a>
        : <a class="btn principal" href={lien(lang, '/terminale/')}>{T.cta}</a>}
    </p>

    <div class="grille">
      {T.classes.map((c) => (
        <section class="carte">
          <div class="carte-corps">
            <span class="etat">{u.aVenir}</span>
            <h2>{c.nom}</h2>
            <h3>{u.chapitresPrevus}</h3>
            <ul>{c.chapitres.map((x) => <li>{x}</li>)}</ul>
            <h3>{u.tpEnvisages}</h3>
            <ul>{c.tp.map((x) => <li>{x}</li>)}</ul>
          </div>
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .actions { margin: 1.6rem 0 2.5rem; }
  .etat { font: 600 .72rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--doux); }
  .carte h2 { font-size: 1.9rem; margin: 0; }
  .carte h3 { font: 600 .8rem/1.2 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--doux); margin-top: .6rem; }
  .carte ul { margin: 0; padding-left: 1.15rem; }
  .carte li { margin-bottom: .25em; }
</style>
