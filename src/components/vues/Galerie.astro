---
import Base from '../../layouts/Base.astro';
import CarteTp from '../CarteTp.astro';
import { ORDRE_THEMES, THEMES } from '../../data/site';
import { UI, lien, type Lang } from '../../i18n';
import { lesTp } from '../../i18n/contenu';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = UI[lang];
const tps = await lesTp(lang);

const T = {
  fr: {
    titre: 'TP animés de physique-chimie',
    description: 'Tous les travaux pratiques animés : titrages, cinétique, mécanique, ondes, électricité. Chaque expérience se déroule pas à pas, avec des paramètres à régler.',
    chapo: `${tps.length} expériences à regarder, mettre en pause et modifier. Choisissez un thème ou parcourez tout.`,
    filtrer: 'Filtrer par thème',
    tous: 'Tous',
  },
  en: {
    titre: 'Animated physics and chemistry practicals',
    description: 'All the animated practicals: titrations, kinetics, mechanics, waves, electricity. Each experiment unfolds step by step, with parameters to adjust.',
    chapo: `${tps.length} experiments to watch, pause and modify. Choose a theme or browse them all.`,
    filtrer: 'Filter by theme',
    tous: 'All',
  },
}[lang];
---

<Base lang={lang} titre={T.titre} description={T.description}>
  <section class="section conteneur">
    <ol class="fil"><li><a href={lien(lang, '/')}>{u.accueil}</a></li><li>{u.tpAnimes}</li></ol>
    <h1>{u.tpAnimes}</h1>
    <p class="chapo">{T.chapo}</p>
    <div class="filtres" role="group" aria-label={T.filtrer}>
      <button type="button" class="pastille actif" data-filtre="">{T.tous}</button>
      {ORDRE_THEMES.map((t) => <button type="button" class="pastille" data-theme={t} data-filtre={t}>{THEMES[t][lang].court}</button>)}
    </div>
    <div class="grille" id="galerie">
      {tps.map((tp) => <div data-t={tp.data.theme}><CarteTp tp={tp} lang={lang} /></div>)}
    </div>
  </section>
</Base>

<script>
  const boutons = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
  boutons.forEach((b) =>
    b.addEventListener('click', () => {
      boutons.forEach((x) => x.classList.toggle('actif', x === b));
      document.querySelectorAll<HTMLElement>('#galerie > [data-t]').forEach((c) => {
        c.hidden = !!b.dataset.filtre && c.dataset.t !== b.dataset.filtre;
      });
    }),
  );
</script>

<style>
  .filtres { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0 2rem; }
  .filtres button { background: transparent; cursor: pointer; min-height: 44px; padding-inline: 1rem; }
  .filtres button.actif { background: var(--t, var(--encre)); color: var(--fond); border-color: var(--t, var(--encre)); }
  #galerie > div { display: grid; }
</style>
