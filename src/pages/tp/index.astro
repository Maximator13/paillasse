---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CarteTp from '../../components/CarteTp.astro';
import { ORDRE_THEMES, THEMES } from '../../data/site';

const tps = (await getCollection('tp')).sort((a, b) => a.data.ordre - b.data.ordre);
---

<Base
  titre="TP animés de physique-chimie"
  description="Tous les travaux pratiques animés : titrages, cinétique, mécanique, ondes, électricité. Chaque expérience se déroule pas à pas, avec des paramètres à régler."
>
  <section class="section conteneur">
    <ol class="fil"><li><a href="/">Accueil</a></li><li>TP animés</li></ol>
    <h1>TP animés</h1>
    <p class="chapo">{tps.length} expériences à regarder, mettre en pause et modifier. Choisissez un thème ou parcourez tout.</p>
    <div class="filtres" role="group" aria-label="Filtrer par thème">
      <button type="button" class="pastille actif" data-filtre="">Tous</button>
      {ORDRE_THEMES.map((t) => <button type="button" class="pastille" data-theme={t} data-filtre={t}>{THEMES[t].court}</button>)}
    </div>
    <div class="grille" id="galerie">
      {tps.map((tp) => <div data-t={tp.data.theme}><CarteTp tp={tp} /></div>)}
    </div>
  </section>
</Base>

<script>
  const boutons = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
  boutons.forEach((b) =>
    b.addEventListener('click', () => {
      boutons.forEach((x) => x.classList.toggle('actif', x === b));
      document.querySelectorAll<HTMLElement>('#galerie > [data-t]').forEach((c) => {
        c.hidden = !!b.dataset.filtre && c.dataset.t !== b.dataset.filtre;
      });
    }),
  );
</script>

<style>
  .filtres { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0 2rem; }
  .filtres button { background: transparent; cursor: pointer; min-height: 44px; padding-inline: 1rem; }
  .filtres button.actif { background: var(--t, var(--encre)); color: var(--fond); border-color: var(--t, var(--encre)); }
  #galerie > div { display: grid; }
</style>
