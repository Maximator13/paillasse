---
import Base from '../../layouts/Base.astro';

const classes = [
  {
    nom: 'MPSI',
    chapitres: ['Mécanique du point et oscillateurs', 'Circuits électriques en régime transitoire', 'Optique géométrique', 'Premier et second principes de la thermodynamique', 'Architecture de la matière et cristallographie'],
    tp: ['Pendule simple et non-linéarité', 'Circuit RLC série : régimes libres', 'Focométrie de lentilles minces'],
  },
  {
    nom: 'PCSI',
    chapitres: ['Cinétique chimique et mécanismes', 'Équilibres acido-basiques et de précipitation', 'Oxydoréduction et diagrammes E-pH', 'Mécanique du point et du solide', 'Thermodynamique des machines'],
    tp: ['Méthode des vitesses initiales', 'Titrage par précipitation', 'Cycle d\'un moteur ditherme'],
  },
];
---

<Base titre="Physique-chimie en prépa" description="Programme prévu pour les classes préparatoires MPSI et PCSI : chapitres et TP animés en préparation, de la mécanique aux équilibres chimiques.">
  <section class="section conteneur">
    <ol class="fil"><li><a href="/">Accueil</a></li><li aria-current="page">Prépa</li></ol>
    <p class="surtitre">Classes préparatoires · À venir</p>
    <h1>La prépa est en préparation.</h1>
    <p class="chapo">
      Les cours et TP animés de première année de prépa scientifique sont en cours d'écriture. Voici le programme prévu.
      Pour réviser les bases indispensables, commencez par la Terminale.
    </p>
    <p class="actions"><a class="btn principal" href="/terminale/">Réviser la Terminale</a></p>

    <div class="grille">
      {classes.map((c) => (
        <section class="carte">
          <div class="carte-corps">
            <span class="etat">À venir</span>
            <h2>{c.nom}</h2>
            <h3>Chapitres prévus</h3>
            <ul>{c.chapitres.map((x) => <li>{x}</li>)}</ul>
            <h3>TP animés envisagés</h3>
            <ul>{c.tp.map((x) => <li>{x}</li>)}</ul>
          </div>
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .actions { margin: 1.6rem 0 2.5rem; }
  .etat { font: 600 .72rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--doux); }
  .carte h2 { font-size: 1.9rem; margin: 0; }
  .carte h3 { font: 600 .8rem/1.2 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--doux); margin-top: .6rem; }
  .carte ul { margin: 0; padding-left: 1.15rem; }
  .carte li { margin-bottom: .25em; }
</style>
