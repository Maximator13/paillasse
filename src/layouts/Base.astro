---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { SITE } from '../data/site';
import BandeauCookies from '../components/BandeauCookies.astro';

interface Props {
  titre: string;
  description: string;
  /** Chemin d'une image de partage, relatif à la racine du site. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { titre, description, image = '/og.png', type = 'website', noindex = false } = Astro.props;
// Le nom du site n'est ajouté que si le titre reste sous 65 caractères : au-delà, les moteurs de recherche le tronquent.
const avecNom = `${titre} | ${SITE.nom}`;
const titreComplet = titre === SITE.nom ? `${SITE.nom} : ${SITE.slogan}` : avecNom.length <= 65 ? avecNom : titre;
const canonique = new URL(Astro.url.pathname, Astro.site);
const imageAbs = new URL(image, Astro.site);
const ici = Astro.url.pathname;
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.nom,
  description: SITE.description,
  url: new URL('/', Astro.site).href,
  inLanguage: 'fr-FR',
});
const nav = [
  { href: '/terminale/', label: 'Terminale' },
  { href: '/tp/', label: 'TP animés' },
  { href: '/college/', label: 'Collège' },
  { href: '/prepa/', label: 'Prépa' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {gsc && <meta name="google-site-verification" content={gsc} />}
    <script type="application/ld+json" set:html={jsonLd} />
    <meta name="theme-color" content="#0b1022" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageAbs} />
    <slot name="head" />
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <header class="entete">
      <div class="conteneur entete-in">
        <a class="logo" href="/" aria-label={`${SITE.nom}, accueil`}>
          <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
            <path d="M12 3h8M13 3v9L5.5 25.5A2.4 2.4 0 0 0 7.6 29h16.8a2.4 2.4 0 0 0 2.1-3.5L19 12V3" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M9.2 22h13.6l2 3.9a.8.8 0 0 1-.7 1.1H7.9a.8.8 0 0 1-.7-1.1z" fill="var(--accent)"></path>
          </svg>
          <span>{SITE.nom}</span>
        </a>
        <nav aria-label="Navigation principale">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={ici.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenu"><slot /></main>
    <footer class="pied">
      <div class="conteneur pied-in">
        <p><strong>{SITE.nom}</strong> : {SITE.slogan.toLowerCase()}.</p>
        <ul>
          <li><a href="/mentions-legales/">Mentions légales</a></li>
          <li><a href="/confidentialite/">Confidentialité</a></li>
          <li><a href="/cgu/">CGU</a></li>
          <li><button type="button" data-cookies-ouvrir>Gérer les cookies</button></li>
        </ul>
      </div>
    </footer>
    <BandeauCookies />
  </body>
</html>

<style>
  .entete { background: color-mix(in srgb, var(--fond) 86%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--ligne); }
  @media (min-width: 720px) { .entete { position: sticky; top: 0; z-index: 20; } }
  .entete-in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 64px; flex-wrap: wrap; }
  .logo { display: inline-flex; align-items: center; gap: .55rem; font: 650 1.4rem/1 var(--titre); letter-spacing: -.01em; color: var(--encre); text-decoration: none; min-height: 48px; }
  nav ul { display: flex; gap: .2rem; list-style: none; margin: 0; padding: 0; overflow-x: auto; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 .8rem; border-radius: 8px; color: var(--encre); text-decoration: none; font-weight: 550; font-size: .97rem; white-space: nowrap; }
  nav a:hover { background: var(--ligne); }
  nav a[aria-current='page'] { background: var(--encre); color: var(--fond); }
  .pied { border-top: 1px solid var(--ligne); margin-top: 3rem; padding-block: 2rem; color: var(--doux); font-size: .95rem; }
  .pied-in { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem 2rem; align-items: center; }
  .pied p { margin: 0; }
  .pied ul { display: flex; flex-wrap: wrap; gap: .3rem 1.2rem; list-style: none; margin: 0; padding: 0; }
  .pied a, .pied button { color: inherit; font: inherit; background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: .18em; min-height: 44px; display: inline-flex; align-items: center; }
</style>
