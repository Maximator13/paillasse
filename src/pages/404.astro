---
import Vue from '../components/vues/Introuvable.astro';
---

<Vue lang="fr" />

<script>
  import { lien } from '../i18n';
  // L'hébergement statique ne sert qu'une seule page 404 : une adresse anglaise introuvable est renvoyée vers la version anglaise.
  const en = lien('en', '/');
  if (location.pathname.startsWith(en) && location.pathname !== `${en}404/`) location.replace(`${en}404/`);
</script>
