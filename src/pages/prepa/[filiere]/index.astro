---
// Programme d'une filière de prépa : chapitres par année, matière puis partie du programme.
import Base from '../../../layouts/Base.astro';
import { ANNEES, FILIERES, MATIERES, lesChapitres, lienChapitre } from '../../../data/prepa';
import { UI, lien } from '../../../i18n';

export const getStaticPaths = () => FILIERES.filter((f) => f.dispo).map((f) => ({ params: { filiere: f.id }, props: { f } }));
const { f } = Astro.props;
const u = UI.fr;
const chapitres = await lesChapitres(f.id);
const premier = chapitres[0];
const NOMS_ANNEES = { 1: 'Première année', 2: 'Deuxième année' };

/** Chapitres regroupés par partie, dans l'ordre de leur première apparition. */
const parPartie = (liste: typeof chapitres) => {
  const groupes = new Map<string, typeof chapitres>();
  for (const c of liste) groupes.set(c.data.partie, [...(groupes.get(c.data.partie) ?? []), c]);
  return [...groupes];
};
---

<Base lang="fr" titre={f.titre} description={f.description} sansTraduction="/prepa/">
  <section class="section conteneur">
    <ol class="fil">
      <li><a href={lien('fr', '/')}>{u.accueil}</a></li>
      <li><a href={lien('fr', '/prepa/')}>Prépa</a></li>
      <li aria-current="page">{f.nom}</li>
    </ol>
    <p class="surtitre">Filière {f.nom} · {f.intitule}</p>
    <h1>Prépa {f.nom}</h1>
    <p class="chapo">
      {chapitres.length === 0
        ? "Les chapitres sont en cours de relecture : ils seront publiés ici au fur et à mesure, dans l'ordre du programme officiel."
        : `${chapitres.length} chapitre${chapitres.length > 1 ? 's' : ''} publié${chapitres.length > 1 ? 's' : ''} pour l'instant, dans l'ordre du programme officiel.`}{' '}
      Chaque chapitre réunit une fiche condensée, des exercices type concours corrigés, les formules à retenir et un QCM.
    </p>
    {premier && <p class="actions"><a class="btn principal" href={lienChapitre(premier)}>Commencer : {premier.data.titre}</a></p>}
    <nav class="sommaire" aria-label="Années">
      {ANNEES.map((a) => <a class="pastille" href={`#${f.id}${a}`}>{f.nom}{a}</a>)}
    </nav>
  </section>

  {ANNEES.map((a) => (
    <section class="section conteneur annee" id={`${f.id}${a}`}>
      <p class="surtitre">{f.nom}{a}</p>
      <h2>{NOMS_ANNEES[a]}</h2>
      {Object.entries(MATIERES).map(([m, nom]) => {
        const liste = chapitres.filter((c) => c.data.annee === a && c.data.matiere === m);
        return (
          <section class="matiere">
            <h3>{nom}</h3>
            {liste.length === 0 ? (
              <p class="vide">Chapitres en cours de relecture.</p>
            ) : (
              parPartie(liste).map(([partie, cs]) => (
                <>
                  <h4>{partie}</h4>
                  <ol class="chapitres">
                    {cs.map((c) => (
                      <li>
                        <a href={lienChapitre(c)}>
                          <span class="titre">{c.data.titre}</span>
                          <span class="meta">{c.data.duree} · {c.data.qcm.length} questions · {c.data.formules.length} formules</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </>
              ))
            )}
          </section>
        );
      })}
    </section>
  ))}
</Base>

<style>
  .actions { margin: 1.6rem 0 0; }
  .sommaire { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; }
  .sommaire a { text-decoration: none; min-height: 44px; padding-inline: 1rem; }
  .annee { padding-top: 0; scroll-margin-top: 90px; }
  .annee h2 { border-left: 6px solid var(--accent); padding-left: .8rem; }
  .matiere { margin-top: 2rem; }
  .matiere h3 { font: 600 .8rem/1.2 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--doux); margin-bottom: .8rem; }
  h4 { font: 600 1.15rem/1.3 var(--titre); margin: 1.2rem 0 .5rem; }
  .vide { color: var(--doux); margin: 0; }
  .chapitres { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ligne); }
  .chapitres a { display: grid; gap: .2rem 2rem; grid-template-columns: minmax(0, 1fr); padding: .9rem .4rem; border-bottom: 1px solid var(--ligne); color: var(--encre); text-decoration: none; transition: background .15s; }
  .chapitres a:hover { background: var(--surface); }
  .chapitres .titre { font-weight: 650; color: var(--accent); text-decoration: underline; text-underline-offset: .18em; text-decoration-thickness: 1px; }
  .chapitres .meta { font: 500 .8rem/1.5 var(--mono); color: var(--doux); }
  @media (min-width: 760px) { .chapitres a { grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; } }
</style>
