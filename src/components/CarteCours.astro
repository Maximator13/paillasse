---
import type { CollectionEntry } from 'astro:content';
import { THEMES, slugDe } from '../data/site';

interface Props {
  cours: CollectionEntry<'cours'>;
}
const { cours } = Astro.props;
const n = cours.data.tp.length;
---

<a class="carte" href={`/${cours.data.niveau}/cours/${slugDe(cours.id)}/`} data-theme={cours.data.theme}>
  <div class="carte-corps">
    <span class="num">{String(cours.data.ordre).padStart(2, '0')}</span>
    <h3>{cours.data.titre}</h3>
    <p>{cours.data.description}</p>
    <div class="meta">
      <span class="pastille" data-theme={cours.data.theme}>{THEMES[cours.data.theme].court}</span>
      <span>{cours.data.duree}{n > 0 && ` · ${n} TP animé${n > 1 ? 's' : ''}`}</span>
    </div>
  </div>
</a>

<style>
  .num { font: 700 .85rem/1 var(--mono); color: var(--t); }
</style>
