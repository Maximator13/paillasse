---
import Lecteur from './Lecteur.astro';
import { THEMES, slugDe } from '../data/site';
import { UI, type Lang } from '../i18n';
import { langDe, lienTp, type Tp } from '../i18n/contenu';

interface Props {
  tp: Tp;
  /** Langue de la page. La fiche elle-même peut être en français si sa traduction manque. */
  lang?: Lang;
}
const { tp, lang = 'fr' } = Astro.props;
const slug = slugDe(tp.id);
---

<a class="carte" href={lienTp(tp)} data-theme={tp.data.theme} lang={langDe(tp) !== lang ? langDe(tp) : undefined}>
  <div class="vignette" aria-hidden="true"><Lecteur slug={slug} titre={tp.data.titre} mode="affiche" lang={lang} /></div>
  <div class="carte-corps">
    <h3>{tp.data.titre}</h3>
    <p>{tp.data.description}</p>
    <div class="meta" lang={lang}>
      <span class="pastille" data-theme={tp.data.theme}>{THEMES[tp.data.theme][lang].court}</span>
      <span>{UI[lang].tpAnime} · {tp.data.duree}</span>
    </div>
  </div>
</a>

<style>
  .vignette { background: var(--scene); aspect-ratio: 4 / 3; overflow: hidden; pointer-events: none; }
</style>
