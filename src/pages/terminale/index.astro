---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CarteCours from '../../components/CarteCours.astro';
import CarteTp from '../../components/CarteTp.astro';
import { ORDRE_THEMES, THEMES } from '../../data/site';

const cours = (await getCollection('cours', (c) => c.data.niveau === 'terminale')).sort((a, b) => a.data.ordre - b.data.ordre);
const tps = (await getCollection('tp', (t) => t.data.niveau === 'terminale')).sort((a, b) => a.data.ordre - b.data.ordre);
---

<Base
  titre="Physique-chimie Terminale spécialité : cours et TP animés"
  description="Tout le programme de spécialité physique-chimie de Terminale : fiches de cours claires et travaux pratiques animés, classés par thème."
>
  <section class="section conteneur">
    <ol class="fil"><li><a href="/">Accueil</a></li><li>Terminale</li></ol>
    <p class="surtitre">Lycée · spécialité physique-chimie</p>
    <h1>Terminale</h1>
    <p class="chapo">
      {cours.length} chapitres et {tps.length} TP animés, organisés selon les quatre thèmes du programme officiel.
    </p>
    <nav class="sommaire" aria-label="Thèmes du programme">
      {ORDRE_THEMES.map((t) => <a class="pastille" data-theme={t} href={`#${t}`}>{THEMES[t].court}</a>)}
    </nav>
  </section>

  {ORDRE_THEMES.map((t) => {
    const cs = cours.filter((c) => c.data.theme === t);
    const ts = tps.filter((x) => x.data.theme === t);
    return (
      <section class="section conteneur theme" id={t} data-theme={t}>
        <p class="surtitre">{THEMES[t].matiere}</p>
        <h2>{THEMES[t].label}</h2>
        <h3 class="sous">Cours</h3>
        <div class="grille">{cs.map((c) => <CarteCours cours={c} />)}</div>
        {ts.length > 0 && (
          <>
            <h3 class="sous">TP animés</h3>
            <div class="grille">{ts.map((x) => <CarteTp tp={x} />)}</div>
          </>
        )}
      </section>
    );
  })}
</Base>

<style>
  .sommaire { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; }
  .sommaire a { text-decoration: none; min-height: 44px; padding-inline: 1rem; }
  .theme { padding-top: 0; scroll-margin-top: 90px; }
  .theme h2 { border-left: 6px solid var(--t); padding-left: .8rem; }
  .sous { margin: 2rem 0 1rem; font: 600 .8rem/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--doux); }
</style>
