---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import Lecteur from '../Lecteur.astro';
import { THEMES, slugDe } from '../../data/site';
import { UI, lien, type Lang } from '../../i18n';
import { lesCours, lienCours, type Tp } from '../../i18n/contenu';

interface Props {
  lang: Lang;
  tp: Tp;
  /** Vrai si le TP existe dans les deux langues. */
  traduit: boolean;
}
const { lang, tp, traduit } = Astro.props;
const u = UI[lang];
const { Content } = await render(tp);
const d = tp.data;
const slug = slugDe(tp.id);
const chapitre = (await lesCours(lang)).find((c) => slugDe(c.id) === d.chapitre);

const T = {
  fr: {
    suffixe: ' : TP animé',
    surtitre: `TP de ${d.matiere} · ${d.duree} en classe`,
    objectifs: 'Objectifs',
    materiel: 'Matériel',
    revoir: 'Revoir le cours : ',
  },
  en: {
    suffixe: ': animated practical',
    surtitre: `${{ physique: 'Physics', chimie: 'Chemistry' }[d.matiere]} practical · ${d.duree} in class`,
    objectifs: 'Objectives',
    materiel: 'Equipment',
    revoir: 'Review the lesson: ',
  },
}[lang];
// Le suffixe n'est ajouté que si le titre reste court.
const titre = `${d.titre}${T.suffixe}`.length <= 51 ? `${d.titre}${T.suffixe}` : d.titre;
---

<Base lang={lang} titre={titre} description={d.description} type="article" sansTraduction={traduit ? undefined : '/tp/'}>
  <article data-theme={d.theme}>
    <header class="conteneur tete">
      <ol class="fil">
        <li><a href={lien(lang, '/')}>{u.accueil}</a></li>
        <li><a href={lien(lang, '/terminale/')}>Terminale</a></li>
        <li><a href={lien(lang, '/tp/')}>{u.tpAnimes}</a></li>
      </ol>
      <p class="surtitre"><span class="pastille" data-theme={d.theme}>{THEMES[d.theme][lang].court}</span> {T.surtitre}</p>
      <h1>{d.titre}</h1>
      <p class="chapo">{d.description}</p>
    </header>

    <div class="conteneur"><Lecteur slug={slug} titre={d.titre} lang={lang} /></div>

    <div class="conteneur corps">
      <aside class="fiche">
        <h2>{T.objectifs}</h2>
        <ul>{d.objectifs.map((o) => <li>{o}</li>)}</ul>
        <h2>{T.materiel}</h2>
        <ul>{d.materiel.map((m) => <li>{m}</li>)}</ul>
        {chapitre && (
          <p class="lien-cours"><a class="btn" href={lienCours(chapitre)}>{T.revoir}{chapitre.data.titre}</a></p>
        )}
      </aside>
      <div class="prose"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .tete { padding-block: clamp(2rem, 5vw, 3.5rem) 1.5rem; }
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .surtitre { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; }
  .corps { display: grid; gap: 2.5rem; padding-block: 3rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 980px) { .corps { grid-template-columns: 320px minmax(0, 1fr); gap: 4rem; } .fiche { position: sticky; top: 90px; align-self: start; } }
  .fiche { background: var(--surface); border: 1.5px solid var(--ligne); border-radius: var(--rayon); padding: 1.4rem; }
  .fiche h2 { font: 600 .8rem/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--t); margin: 0 0 .8rem; }
  .fiche ul { margin: 0 0 1.6rem; padding-left: 1.1rem; font-size: .97rem; }
  .fiche li { margin-bottom: .35em; }
  .lien-cours { margin: 0; }
  .lien-cours .btn { border-radius: 14px; line-height: 1.3; font-size: .95rem; }
  .prose :global(h2:first-child) { margin-top: 0; }
</style>
