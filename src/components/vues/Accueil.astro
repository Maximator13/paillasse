---
import Base from '../../layouts/Base.astro';
import Lecteur from '../Lecteur.astro';
import CarteTp from '../CarteTp.astro';
import { CYCLES, ORDRE_THEMES, SITE, THEMES, slugDe } from '../../data/site';
import { UI, lien, type Lang } from '../../i18n';
import { lesCours, lesTp } from '../../i18n/contenu';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = UI[lang];
const tps = await lesTp(lang);
const cours = await lesCours(lang);
// Sélection de la une : un mélange de thèmes, complété par les premiers TP si l'un d'eux manque.
const UNE = ['interferences-young', 'pile-daniell', 'satellite-kepler', 'effet-doppler', 'circuit-rc', 'synthese-ester'];
const aLaUne = [...UNE.map((s) => tps.find((t) => slugDe(t.id) === s)).filter((t) => t !== undefined), ...tps]
  .filter((t, i, a) => a.indexOf(t) === i)
  .slice(0, 6);

const T = {
  fr: {
    surtitre: 'Physique-chimie · Terminale spécialité',
    h1: ["Regardez l'expérience ", 'se faire'],
    chapo: 'Chaque travail pratique se déroule sous vos yeux, étape par étape. Mettez en pause, revenez en arrière, changez une concentration ou une masse, et voyez le phénomène réagir.',
    cta: 'Explorer les TP animés',
    demo: 'Titrage pH-métrique',
    legende: "Fig. 1. Titrage pH-métrique d'un acide par la soude, en direct.",
    chiffres: ['TP animés et interactifs', 'chapitres de cours', 'thèmes du programme officiel', 'inscription, tout est en accès libre'],
    methodeSur: 'La méthode',
    methodeTitre: 'Voir, puis manipuler, puis comprendre',
    methode: [
      { titre: 'Regarder', texte: "L'expérience se déroule étape par étape, comme sur la paillasse : on prélève, on verse, on mesure. Chaque geste est expliqué au moment où il se fait." },
      { titre: 'Régler', texte: 'Une concentration, une masse, une fréquence : déplacez un curseur et la scène, les mesures et la courbe se recalculent aussitôt.' },
      { titre: 'Comprendre', texte: 'Chaque TP renvoie au chapitre de cours correspondant, avec ses définitions, un exercice type corrigé et les erreurs à éviter.' },
    ],
    programmeSur: 'Le programme',
    programmeTitre: 'Tout le programme de Terminale, en quatre thèmes',
    compte: (c: number, t: number) => `${c} chapitres · ${t} TP`,
    uneSur: 'À la une',
    uneTitre: 'Des TP qui bougent',
    tous: (n: number) => `Voir les ${n} TP animés`,
    cyclesSur: 'Trois cycles',
    cyclesTitre: 'Du collège à la prépa',
  },
  en: {
    surtitre: 'Physics and chemistry · Terminale speciality',
    h1: ['Watch the experiment ', 'happen'],
    chapo: 'Every practical unfolds before your eyes, step by step. Pause, go back, change a concentration or a mass, and watch the phenomenon respond.',
    cta: 'Explore the animated practicals',
    demo: 'pH titration',
    legende: 'Fig. 1. pH titration of an acid with sodium hydroxide solution, live.',
    chiffres: ['interactive animated practicals', 'lesson chapters', 'themes of the official syllabus', 'sign-ups, everything is free to access'],
    methodeSur: 'The method',
    methodeTitre: 'Watch, then experiment, then understand',
    methode: [
      { titre: 'Watch', texte: 'The experiment unfolds step by step, just as it does on the bench: you take a sample, you pour, you measure. Each action is explained as it happens.' },
      { titre: 'Adjust', texte: 'A concentration, a mass, a frequency: move a slider and the scene, the measurements and the curve are recalculated at once.' },
      { titre: 'Understand', texte: 'Each practical links to the matching lesson chapter, with its definitions, a worked example with its solution and the mistakes to avoid.' },
    ],
    programmeSur: 'The syllabus',
    programmeTitre: 'The whole Terminale syllabus, in four themes',
    compte: (c: number, t: number) => `${c} chapters · ${t} practicals`,
    uneSur: 'Featured',
    uneTitre: 'Practicals in motion',
    tous: (n: number) => `See all ${n} animated practicals`,
    cyclesSur: 'Three stages',
    cyclesTitre: 'From collège to prépa',
  },
}[lang];
const chiffres = [tps.length, cours.length, ORDRE_THEMES.length, 0];
---

<Base lang={lang} titre={SITE.nom} description={SITE.description[lang]}>
  <section class="conteneur hero">
    <div>
      <p class="surtitre">{T.surtitre}</p>
      <h1>{T.h1[0]}<em>{T.h1[1]}</em>.</h1>
      <p class="chapo">{T.chapo}</p>
      <p class="actions"><a class="btn principal" href={lien(lang, '/tp/')}>{T.cta}</a></p>
    </div>
    <figure class="hero-demo">
      <Lecteur slug="titrage-ph-metrique" titre={T.demo} mode="demo" lang={lang} />
      <figcaption>{T.legende}</figcaption>
    </figure>
  </section>

  <section class="conteneur">
    <ul class="chiffres">
      {chiffres.map((n, i) => <li><strong>{n}</strong> {T.chiffres[i]}</li>)}
    </ul>
  </section>

  <section class="section conteneur">
    <p class="surtitre">{T.methodeSur}</p>
    <h2>{T.methodeTitre}</h2>
    <ol class="methode">
      {T.methode.map((m, i) => (
        <li>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <h3>{m.titre}</h3>
          <p>{m.texte}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section conteneur">
    <p class="surtitre">{T.programmeSur}</p>
    <h2>{T.programmeTitre}</h2>
    <ul class="themes">
      {ORDRE_THEMES.map((t) => (
        <li data-theme={t}>
          <a href={lien(lang, `/terminale/#${t}`)}>
            <span class="matiere">{THEMES[t][lang].matiere}</span>
            <span class="nom">{THEMES[t][lang].label}</span>
            <span class="compte">
              {T.compte(cours.filter((c) => c.data.theme === t).length, tps.filter((x) => x.data.theme === t).length)}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section conteneur">
    <p class="surtitre">{T.uneSur}</p>
    <h2>{T.uneTitre}</h2>
    <div class="grille">
      {aLaUne.map((tp) => <CarteTp tp={tp} lang={lang} />)}
    </div>
    <p class="suite"><a href={lien(lang, '/tp/')}>{T.tous(tps.length)}</a></p>
  </section>

  <section class="section conteneur">
    <p class="surtitre">{T.cyclesSur}</p>
    <h2>{T.cyclesTitre}</h2>
    <div class="grille">
      {CYCLES.map((c) => (
        <a class="carte cycle" href={lien(lang, c.chemin)}>
          <div class="carte-corps">
            <span class:list={['etat', { dispo: c.dispo }]}>{c.dispo ? u.disponible : u.aVenir}</span>
            <h3>{c[lang].titre}</h3>
            <p class="classes">{c[lang].classes}</p>
            <p>{c[lang].resume}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; gap: 2.5rem; padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(2rem, 5vw, 3.5rem); align-items: center; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 980px) { .hero { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 4rem; } }
  h1 em { font-style: italic; color: var(--accent); }
  .actions { margin: 1.8rem 0 0; }
  .hero-demo { margin: 0; }
  figcaption { font: italic 400 .92rem/1.4 var(--titre); color: var(--doux); margin-top: .8rem; }

  .chiffres { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1.2rem 2rem; list-style: none; margin: 0; padding: 1.6rem 0; border-block: 1px solid var(--ligne); color: var(--doux); font-size: .95rem; }
  .chiffres strong { display: block; font: 600 2.4rem/1.1 var(--titre); color: var(--encre); font-variant-numeric: lining-nums; }

  .methode { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 2rem 3rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
  .methode li { border-top: 2px solid var(--encre); padding-top: 1rem; }
  .methode .num { font: italic 400 2.6rem/1 var(--titre); color: var(--accent); display: block; margin-bottom: .6rem; }
  .methode p { color: var(--doux); margin: 0; }

  .themes { list-style: none; margin: 2rem 0 0; padding: 0; border-top: 1px solid var(--ligne); }
  .themes a { display: grid; gap: .2rem 2rem; grid-template-columns: minmax(0, 1fr); padding: 1.1rem .4rem; border-bottom: 1px solid var(--ligne); color: var(--encre); text-decoration: none; transition: background .15s; }
  .themes a:hover { background: var(--surface); }
  .themes .matiere, .themes .compte { font: 600 .8rem/1.6 var(--mono); letter-spacing: .06em; text-transform: uppercase; }
  .themes .matiere { color: var(--t); }
  .themes .compte { color: var(--doux); }
  .themes .nom { font: 600 1.35rem/1.25 var(--titre); }
  @media (min-width: 760px) { .themes a { grid-template-columns: 9rem minmax(0, 1fr) auto; align-items: baseline; } }

  .cycle .etat { font: 600 .72rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--doux); }
  .cycle .etat.dispo { color: var(--t-matiere); }
  .cycle h3 { font-size: 1.7rem; }
  .cycle .classes { font: 600 .9rem/1.3 var(--mono); color: var(--encre); }
  .suite { margin-top: 1.5rem; font-weight: 600; }
</style>
