---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Lecteur from '../components/Lecteur.astro';
import CarteTp from '../components/CarteTp.astro';
import { CYCLES, ORDRE_THEMES, SITE, THEMES, slugDe } from '../data/site';

const tps = (await getCollection('tp')).sort((a, b) => a.data.ordre - b.data.ordre);
const cours = await getCollection('cours');
// Sélection de la une : un mélange de thèmes, complété par les premiers TP si l'un d'eux manque.
const UNE = ['interferences-young', 'pile-daniell', 'satellite-kepler', 'effet-doppler', 'circuit-rc', 'synthese-ester'];
const aLaUne = [...UNE.map((s) => tps.find((t) => slugDe(t.id) === s)).filter((t) => t !== undefined), ...tps]
  .filter((t, i, a) => a.indexOf(t) === i)
  .slice(0, 6);
const METHODE = [
  { titre: 'Regarder', texte: "L'expérience se déroule étape par étape, comme sur la paillasse : on prélève, on verse, on mesure. Chaque geste est expliqué au moment où il se fait." },
  { titre: 'Régler', texte: 'Une concentration, une masse, une fréquence : déplacez un curseur et la scène, les mesures et la courbe se recalculent aussitôt.' },
  { titre: 'Comprendre', texte: "Chaque TP renvoie au chapitre de cours correspondant, avec ses définitions, un exercice type corrigé et les erreurs à éviter." },
];
---

<Base titre={SITE.nom} description={SITE.description}>
  <section class="conteneur hero">
    <div>
      <p class="surtitre">Physique-chimie · Terminale spécialité</p>
      <h1>Regardez l'expérience <em>se faire</em>.</h1>
      <p class="chapo">
        Chaque travail pratique se déroule sous vos yeux, étape par étape. Mettez en pause, revenez en arrière,
        changez une concentration ou une masse, et voyez le phénomène réagir.
      </p>
      <p class="actions"><a class="btn principal" href="/tp/">Explorer les TP animés</a></p>
    </div>
    <figure class="hero-demo">
      <Lecteur slug="titrage-ph-metrique" titre="Titrage pH-métrique" mode="demo" />
      <figcaption>Fig. 1. Titrage pH-métrique d'un acide par la soude, en direct.</figcaption>
    </figure>
  </section>

  <section class="conteneur">
    <ul class="chiffres">
      <li><strong>{tps.length}</strong> TP animés et interactifs</li>
      <li><strong>{cours.length}</strong> chapitres de cours</li>
      <li><strong>{ORDRE_THEMES.length}</strong> thèmes du programme officiel</li>
      <li><strong>0</strong> inscription, tout est en accès libre</li>
    </ul>
  </section>

  <section class="section conteneur">
    <p class="surtitre">La méthode</p>
    <h2>Voir, puis manipuler, puis comprendre</h2>
    <ol class="methode">
      {METHODE.map((m, i) => (
        <li>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <h3>{m.titre}</h3>
          <p>{m.texte}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section conteneur">
    <p class="surtitre">Le programme</p>
    <h2>Tout le programme de Terminale, en quatre thèmes</h2>
    <ul class="themes">
      {ORDRE_THEMES.map((t) => (
        <li data-theme={t}>
          <a href={`/terminale/#${t}`}>
            <span class="matiere">{THEMES[t].matiere}</span>
            <span class="nom">{THEMES[t].label}</span>
            <span class="compte">
              {cours.filter((c) => c.data.theme === t).length} chapitres · {tps.filter((x) => x.data.theme === t).length} TP
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section conteneur">
    <p class="surtitre">À la une</p>
    <h2>Des TP qui bougent</h2>
    <div class="grille">
      {aLaUne.map((tp) => <CarteTp tp={tp} />)}
    </div>
    <p class="suite"><a href="/tp/">Voir les {tps.length} TP animés</a></p>
  </section>

  <section class="section conteneur">
    <p class="surtitre">Trois cycles</p>
    <h2>Du collège à la prépa</h2>
    <div class="grille">
      {CYCLES.map((c) => (
        <a class="carte cycle" href={c.url}>
          <div class="carte-corps">
            <span class:list={['etat', { dispo: c.dispo }]}>{c.dispo ? 'Disponible' : 'À venir'}</span>
            <h3>{c.titre}</h3>
            <p class="classes">{c.classes}</p>
            <p>{c.resume}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; gap: 2.5rem; padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(2rem, 5vw, 3.5rem); align-items: center; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 980px) { .hero { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 4rem; } }
  h1 em { font-style: italic; color: var(--accent); }
  .actions { margin: 1.8rem 0 0; }
  .hero-demo { margin: 0; }
  figcaption { font: italic 400 .92rem/1.4 var(--titre); color: var(--doux); margin-top: .8rem; }

  .chiffres { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1.2rem 2rem; list-style: none; margin: 0; padding: 1.6rem 0; border-block: 1px solid var(--ligne); color: var(--doux); font-size: .95rem; }
  .chiffres strong { display: block; font: 600 2.4rem/1.1 var(--titre); color: var(--encre); font-variant-numeric: lining-nums; }

  .methode { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 2rem 3rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
  .methode li { border-top: 2px solid var(--encre); padding-top: 1rem; }
  .methode .num { font: italic 400 2.6rem/1 var(--titre); color: var(--accent); display: block; margin-bottom: .6rem; }
  .methode p { color: var(--doux); margin: 0; }

  .themes { list-style: none; margin: 2rem 0 0; padding: 0; border-top: 1px solid var(--ligne); }
  .themes a { display: grid; gap: .2rem 2rem; grid-template-columns: minmax(0, 1fr); padding: 1.1rem .4rem; border-bottom: 1px solid var(--ligne); color: var(--encre); text-decoration: none; transition: background .15s; }
  .themes a:hover { background: var(--surface); }
  .themes .matiere, .themes .compte { font: 600 .8rem/1.6 var(--mono); letter-spacing: .06em; text-transform: uppercase; }
  .themes .matiere { color: var(--t); }
  .themes .compte { color: var(--doux); }
  .themes .nom { font: 600 1.35rem/1.25 var(--titre); }
  @media (min-width: 760px) { .themes a { grid-template-columns: 9rem minmax(0, 1fr) auto; align-items: baseline; } }

  .cycle .etat { font: 600 .72rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--doux); }
  .cycle .etat.dispo { color: var(--t-matiere); }
  .cycle h3 { font-size: 1.7rem; }
  .cycle .classes { font: 600 .9rem/1.3 var(--mono); color: var(--encre); }
  .suite { margin-top: 1.5rem; font-weight: 600; }
</style>
